{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/.well-known/nostr.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/chapters/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json+chapters"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sovereignengineering.io"
        }
      ],
      "destination": "https://sovereignengineering.io/:path*",
      "permanent": true
    },
    {
      "source": "/blog/sec-06-identity-signers",
      "destination": "/blog/sec-06-identity--signers/",
      "permanent": true
    },
    {
      "source": "/nostr.html",
      "destination": "/projects/nostr/",
      "permanent": true
    },
    {
      "source": "/madeira.html",
      "destination": "/concept/#environment",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/faq/",
      "permanent": true
    },
    {
      "source": "/all_posts.html",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/2024/04/04/SEC-02-calling.html",
      "destination": "/blog/1712266342551/",
      "permanent": true
    },
    {
      "source": "/2024/03/20/what-was-SEC-01.html",
      "destination": "/blog/1710949691861/",
      "permanent": true
    },
    {
      "source": "/2023/11/30/meet-the-1st-cohort.html",
      "destination": "/blog/1701345719721/",
      "permanent": true
    },
    {
      "source": "/2024/03/19/what-came-out-of-SEC-01.html",
      "destination": "/blog/1710949472591/",
      "permanent": true
    }
  ]
}
